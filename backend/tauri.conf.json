{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "memora",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "plugins": {
    "dialog": null
  },
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "memora",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
  "security": {
    "csp": null,
    "assetProtocol": {
      "enable": true,
      "scope": [
       "/Users/D069583/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
